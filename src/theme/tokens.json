  "effect": {
    "object": {
      "$type": "shadow",
      "$description": "Tactile circle: two drop shadows + top highlight + bottom shade. Mode-aware via color refs.",
      "$value": [
        {
          "color": "{color.object.shadow}",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "48px",
          "spread": "-8px"
        },
        {
          "color": "{color.object.shadow-near}",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        },
