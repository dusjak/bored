{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        // appleId: Apple ID email for App Store Connect. Add it after the Developer Program enrollment is active. Do not guess.
        // ascAppId: numeric App Store Connect app id from App Information. Not the bundle id.
      }
    },
    "production": {
      "ios": {
        // appleId: same Apple ID as submit.testflight, once you have it.
        // ascAppId: same numeric App Store Connect app id as submit.testflight.
      }
    }
  }
}
