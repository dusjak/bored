{
  "expo": {
    "name": "BORED.",
    "slug": "bored",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "no.bored.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/icon/icon-1024.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "bored. varsler når økta er ferdig."
      }
    },
    "android": {
      "package": "no.bored.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111110",
          "image": "./assets/splash/splash-wordmark-dark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111110",
            "image": "./assets/splash/splash-wordmark-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false,
          "enableRemoteNotifications": false
        }
      ]
    ],
    "scheme": "bored",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "backupMode": "preview",
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "6fb5350f-f6a2-4f6b-ae86-05365f76b9ce"
      }
    },
    "owner": "thekingdule"
  }
}
